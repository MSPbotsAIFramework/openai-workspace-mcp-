# ─── OpenAI Admin API Key ─────────────────────────────────────────────────────
# Required when AUTH_MODE=env (local dev only, single shared key).
# Create in platform.openai.com -> Settings -> Admin API Keys (org Owner only).
# Distinct from a regular sk-... API key — an Admin key cannot call model
# endpoints (chat/completions/etc.), and a regular key cannot call /organization/*.
OPENAI_ADMIN_API_KEY=sk-admin-your_key_here

# Base URL is fixed (no multi-region variants like some other vendors).
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) key provided per-request via the
#             x-openai-admin-key HTTP header. Required for production /
#             multi-tenant deployments (e.g. behind mcp-gateway). No key is
#             cached across requests.
# "env"     — (local dev only) single key loaded from OPENAI_ADMIN_API_KEY.
#             NOT SOP-compliant: the key is shared across all requests; do not use in production.
AUTH_MODE=gateway
